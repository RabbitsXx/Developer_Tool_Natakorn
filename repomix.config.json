{
  "output": {
    "filePath": ".artifacts/repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "showLineNumbers": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.git/**",
      ".artifacts/**",
      ".archive/**",
      ".freebuff/**",
      "**/.env*",
      "**/*.pem",
      "**/*.key",
      "**/database-dumps/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
